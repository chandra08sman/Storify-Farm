APP_NAME="Storify Farm"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="Asia/Jakarta"
APP_URL=http://localhost:8000
APP_LOCALE=id

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database --------------------------------------------------------------
# Supabase memakai PostgreSQL. Ambil nilai host dan password dari
# Supabase Dashboard > Project Settings > Database > Connection parameters.
DB_CONNECTION=pgsql
DB_HOST=db.PROJECT_REF.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=isi_password_database_supabase
DB_SSLMODE=require

# Alternatif lokal jika belum siap memakai Supabase:
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=resend
RESEND_API_KEY=isi_api_key_kamu
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@storifyfarm.id"
MAIL_FROM_NAME="${APP_NAME}"

# --- Storify AI -------------------------------------------------------------
# Untuk Ollama Cloud, gunakan URL https://ollama.com dan isi API key.
# Untuk Ollama lokal, gunakan http://127.0.0.1:11434 tanpa API key.
OLLAMA_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT=8
OLLAMA_MAX_OUTPUT_TOKENS=384

# Isi beberapa key dengan koma tanpa spasi. Saat satu key mendapat 429,
# aplikasi mencoba key/provider berikutnya secara otomatis.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEYS=
OPENAI_MODEL=gpt-4o-mini
